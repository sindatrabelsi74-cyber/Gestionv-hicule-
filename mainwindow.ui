         <property name="styleSheet">
          <string notr="true">QTableWidget {
    background-color: #0b2438;
    color: #dbeafe;
    gridline-color: #173b58;
    border: 1px solid #174568;
    border-radius: 8px;
    selection-background-color: #163f5f;
    selection-color: white;
}

/* En-tête horizontal */
QHeaderView::section {
    background-color: #123653;
    color: #dbeafe;
    padding: 8px;
    border: none;
    border-right: 1px solid #1c496b;
    border-bottom: 2px solid #1e5d87;
    font-size: 12px;
    font-weight: bold;
}

/* Première colonne */
QHeaderView::section:first {
    border-top-left-radius: 8px;
}

/* Dernière colonne */
QHeaderView::section:last {
    border-top-right-radius: 8px;
}

/* Quand la souris passe sur une colonne */
QHeaderView::section:hover {
    background-color: #1a4666;
}

/* Lignes */
QTableWidget::item {
    padding: 6px;
    border-bottom: 1px solid #123b59;
}

/* Ligne sélectionnée */
QTableWidget::item:selected {
    background-color: #1d4f73;
    color: white;
}

</string>
